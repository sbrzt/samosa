@prefix : <https://www.example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .




### QualifiedRelation
:QualifiedRelation a owl:Class ;
    rdfs:label "qualified relation"@en ;
    rdfs:comment "A reified relation between two resources."@en .



### hasRelationSubject
:hasRelationSubject a owl:ObjectProperty ;
    rdfs:label "has relation subject"@en ;
    rdfs:comment "The resource that is the subject of a reified relation."@en ;
    rdfs:domain :QualifiedRelation .



### hasRelationObject
:hasRelationObject a owl:ObjectProperty ;
    rdfs:label "has relation object"@en ;
    rdfs:comment "The resource that is the object of a reified relation."@en ;
    rdfs:domain :QualifiedRelation .



### hasRelationCharacterization
:hasRelationCharacterization a owl:ObjectProperty ;
    rdfs:label "has relation characterization"@en ;
    rdfs:comment "The specific nature or type of a qualified relation."@en ;
    rdfs:domain :QualifiedRelation .



### isCitedBy
:isCitedBy a owl:ObjectProperty ;
    rdfs:label "is cited by"@en ;
    rdfs:comment "The cited entity is cited by the citing entity."@en .

