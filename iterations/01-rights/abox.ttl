@prefix : <https://www.example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .




:paper1 a owl:Thing ;
    :hasRights :rightsstatement1 .



:rightsstatement1 a :RightsStatement ;
    :hasIdentifier :rightsidentifier1 ;
    :hasURL "https://creativecommons.org/licenses/by/1.0/legalcode" .



:rightsidentifier1 a :RightsIdentifier ;
    :hasLiteralValue "CC-BY-1.0" ;
    :usesIdentifierScheme :rightsidentifierscheme1 .



:rightsidentifierscheme1 a :RightsIdentifierScheme ;
    :hasURL "https://spdx.org/licenses/" .

