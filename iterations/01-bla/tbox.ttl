@prefix : <https://www.example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .




### Prompt
:Prompt a owl:Class ;
    rdfs:label "Prompt"@en ;
    rdfs:comment "The input given to a model."@en .



### Instruction
:Instruction a owl:Class ;
    rdfs:label "Instruction"@en ;
    rdfs:comment "A specific task or instruction the model is instructed to perform."@en .



### Context
:Context a owl:Class ;
    rdfs:label "Context"@en ;
    rdfs:comment "External information or additional context that can steer the model to better responses."@en .



### InputData
:InputData a owl:Class ;
    rdfs:label "Input Data"@en ;
    rdfs:comment "the input or question that we are interested to find a response for."@en .



### OutputIndicator
:OutputIndicator a owl:Class ;
    rdfs:label "Output Indicator"@en ;
    rdfs:comment "The type or format of the output."@en .



### usesInstruction
:usesInstruction a owl:Objectproperty ;
    rdfs:label "uses instruction"@en ;
    rdfs:comment "A relation between a Prompt and an Instruction."@en .



### hasContext
:hasContext a owl:Objectproperty ;
    rdfs:label "has context"@en ;
    rdfs:comment "A relation between a Prompt and a Context."@en .



### hasInputData
:hasInputData a owl:Objectproperty ;
    rdfs:label "has input data"@en ;
    rdfs:comment "A relation between a Prompt and some Input Data."@en .



### hasOutputIndicator
:hasOutputIndicator a owl:Objectproperty ;
    rdfs:label "has output indicator"@en ;
    rdfs:comment "A relation between a Prompt and an Output Indicator."@en .

