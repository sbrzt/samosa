      {
        "@value": "\n        :relation-dataset-article a datacite:QualifiedRelation ;\n                datacite:hasRelationSubject :my-resource ;\n                datacite:hasRelationObject :my-article ;\n                datacite:hasRelationCharacterization cito:isCitedBy .\n        "
