@prefix : <https://www.example.org/> .
@prefix datacite: <http://purl.org/spar/datacite/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fabio: <http://purl.org/spar/fabio/> .
@prefix literal: <http://www.essepuntato.it/2010/06/literalreification/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:paper1 a owl:Thing ;
    dcterms:rights :rightsstatement1 .

:rightsidentifier1 a datacite:RightsIdentifier ;
    datacite:usesIdentifierScheme :rightsidentifierscheme1 ;
    literal:hasLiteralValue "CC-BY-1.0" .

:rightsidentifierscheme1 a datacite:RightsIdentifierScheme ;
    fabio:hasURL "https://spdx.org/licenses/"^^xsd:anyURI .

:rightsstatement1 a dcterms:RightsStatement ;
    datacite:hasIdentifier :rightsidentifier1 ;
    fabio:hasURL "https://creativecommons.org/licenses/by/1.0/legalcode"^^xsd:anyURI .

