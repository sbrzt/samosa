@prefix : <https://www.example.org/> .
@prefix datacite: <http://purl.org/spar/datacite/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fabio: <http://purl.org/spar/fabio/> .
@prefix literal: <http://www.essepuntato.it/2010/06/literalreification/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:thing1 a owl:Thing ;
    dcterms:rights :rightsstatement2 .

datacite:spdx a datacite:RightsIdentifierScheme ;
    fabio:hasURL "https://spdx.org/licenses/"^^xsd:anyURI .

:rightsidentifier3 a datacite:RightsIdentifier ;
    datacite:usesIdentifierScheme datacite:spdx ;
    literal:hasLiteralValue "CC-BY-1.0" .

:rightsstatement2 a dcterms:RightsStatement ;
    datacite:hasIdentifier :rightsidentifier3 ;
    fabio:hasURL "https://creativecommons.org/licenses/by/1.0/legalcode"^^xsd:anyURI .

