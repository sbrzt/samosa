{% for p, ns in prefixes.items() %}@prefix {{ p }}: <{{ ns }}> .
{% endfor %}

{% for item in glossary %}
### {{ item.term }}
:{{ item.term }} a owl:{{ item.type }}{% if item.member_of %}, {{ item.member_of }}{% endif %} ;
    rdfs:label {{ item.label | tojson }}@en ;
    rdfs:comment {{ item.definition | tojson }}@en{% if item.subclass_of %} ;
    rdfs:subClassOf {{ item.subclass_of }}{% endif %}{% if item.subproperty_of %} ;
    rdfs:subPropertyOf {{ item.subproperty_of }}{% endif %}{% if item.domain %} ;
    rdfs:domain {{ item.domain }}{% endif %}{% if item.range %} ;
    rdfs:range {{ item.range }}{% endif %} .
{% endfor %}
